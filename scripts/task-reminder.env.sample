# Copy to a gitignored path (e.g. scripts/.env.task-reminder) and fill in values.
# See README "Evening task reminder".

# Path to Firebase service account JSON (never commit this file).
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Firestore team/project id (same as projects/{id}/tasks in the app).
TASK_REMINDER_TEAM_ID=demo-project

# Firebase Auth uid of the person receiving reminders (assigned tasks only).
TASK_REMINDER_UID=

# Optional: set to 1 to list the five most recently updated open tasks for the
# whole team (admin-style). Uses Admin SDK — only on a trusted machine.
# TASK_REMINDER_ALL_OPEN_TASKS=0
