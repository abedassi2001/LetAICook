# Copy to apps/web/.env.production.local before firebase deploy or a production build.
# Never commit real values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=letaicook.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=letaicook
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=letaicook.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Run URL from scripts/deploy-api-cloudrun.ps1
NEXT_PUBLIC_API_BASE_URL=https://letaicook-api-XXXXXXXX-uc.a.run.app

# Do NOT set NEXT_PUBLIC_USE_FIREBASE_EMULATOR in production.
