# Copy to apps/web/.env.local (Next.js loads it automatically).

# --- Firebase (your real project in Google Cloud / Firebase console) ---
# Fill from Firebase console → Project settings → Your apps → Web app.
# Leave NEXT_PUBLIC_USE_FIREBASE_EMULATOR unset (or false) to use cloud Auth + Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — from Firebase console web app config (Google Analytics).
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Only for local Firebase emulators (Firestore :8080, Auth :9099). Omit for production.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# With emulators only: skip roster allowlist checks (do not set in production).
# NEXT_PUBLIC_AUTH_SKIP_EMAIL_ALLOWLIST=true

# --- FastAPI (Gemini / design / Jira routes) — not the same as Firebase ---
# Option A — explicit public API URL (recommended for production):
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com

# Option B — same host as the web app: set LETAICOOK_API_PROXY_TARGET when building
# Next (Vercel/host) to your API origin, then:
# NEXT_PUBLIC_USE_SAME_ORIGIN_API_PROXY=true

# Option C — same hostname as the page, port 8000 (LAN / Docker when you open :3000 by IP):
# NEXT_PUBLIC_API_FOLLOW_WEB_HOST=true
# NEXT_PUBLIC_API_PORT=8000

# Local default if none of the above: http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
