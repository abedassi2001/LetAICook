# Copy to apps/api/.env.local for local runs, or pass via Docker / deployment secrets.
# Never commit real keys.

# From https://aistudio.google.com/ → Get API key (Google AI Studio / Gemini API)
GOOGLE_API_KEY=

# Optional alias — if set, used when GOOGLE_API_KEY is empty
# GEMINI_API_KEY=

# Model for /chat/plan. Default: gemini-2.5-flash-lite (avoid deprecated gemini-2.0-flash — often quota 0 on free tier).
# GEMINI_MODEL=gemini-2.5-flash-lite

# Comma-separated fallbacks if the primary hits 429 / quota (defaults built into the API if unset).
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-3.1-flash-lite
#
# Same key + model settings power /chat/plan and /design-project (system designer JSON, Jira markdown, pitch).

# Optional Jira Cloud (server fallback when web client does not send X-Jira-* headers).
# Prefer OAuth via Settings; manual credentials remain supported in Firestore users/{uid}.
# JIRA_DOMAIN=your-company.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=
# JIRA_DEFAULT_PROJECT_KEY=PROJ

# Firebase ID token verification (same project as apps/web NEXT_PUBLIC_FIREBASE_PROJECT_ID).
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Atlassian OAuth 2.0 (3LO) for one-click Jira connect — create app at https://developer.atlassian.com/console/myapps/
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# Callback must match the app settings exactly (FastAPI route GET /jira/oauth/callback).
# ATLASSIAN_REDIRECT_URI=http://localhost:8000/jira/oauth/callback
# Where to send users after OAuth (Next.js origin).
# FRONTEND_BASE_URL=http://localhost:3000
# Optional: separate secret for signing OAuth state (defaults to ATLASSIAN_CLIENT_SECRET).
# OAUTH_STATE_SECRET=
# Per-uid OAuth token files (refresh tokens never sent to the browser).
# JIRA_OAUTH_DATA_DIR=.jira_oauth_data

# Comma-separated browser origins for CORS (Next.js dev server by default).
# CORS_ORIGINS=http://localhost:3000
# Production example (add your real web origin):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
